# Response headers for terpoir.app, applied by Cloudflare (Pages or Workers
# static assets). The site makes no external requests, so the policy allows
# nothing beyond its own inline styles.

/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The release hash files (publish-hashes.sh) open as text in the browser.
/releases/*/SHA256SUMS
  Content-Type: text/plain; charset=utf-8
/releases/*/SHA256SUMS.sig
  Content-Type: text/plain; charset=utf-8
/releases/*/SBOM-SHA256SUMS
  Content-Type: text/plain; charset=utf-8
/releases/*/PUBLISHED
  Content-Type: text/plain; charset=utf-8
