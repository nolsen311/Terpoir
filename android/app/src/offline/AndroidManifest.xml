<!--
  Added to every variant built without a MapTiler key (app/build.gradle.kts):
  such a build has no online map, so it has no INTERNET permission either,
  whatever MapLibre or ML Kit request.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
</manifest>
