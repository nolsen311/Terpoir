<!--
  ML Kit's Google Data Transport dependency asks for network access to send
  usage metrics. The app still has none: Play services downloads ML Kit's
  model in its own process, and the metrics are never sent from here
  (docs/design-decisions.md, "Rapid product entry"). ACCESS_NETWORK_STATE
  stays (see playOnlyPermissions in app/build.gradle.kts).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
</manifest>
