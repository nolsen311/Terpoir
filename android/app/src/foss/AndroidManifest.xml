<!--
  MapLibre asks to read the network state; the foss app removes that, and
  tells MapLibre it is online instead (app.terpoir.map.OnlineMap). The Play
  app keeps it for ML Kit (see playOnlyPermissions in app/build.gradle.kts).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
</manifest>
