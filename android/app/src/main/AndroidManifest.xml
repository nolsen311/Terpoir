<!--
  No INTERNET permission: the app does not touch the network until a
  feature that needs it is added behind its own toggle. Every requested
  permission must be on the allowlist in app/build.gradle.kts.
  Backups and device-to-device transfers carry nothing (allowBackup for
  Android 11 and below, dataExtractionRules for 12 and up).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal (install-time) permission for the system BiometricPrompt,
         which also covers the device-credential fallback. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- In-app camera for label, receipt and code scans (asked on first
         use). Photos stay in memory; nothing is written to the gallery. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".TerpoirApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Terpoir">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
