<!--
  INTERNET only in builds with a MapTiler key, for the opt-in online map
  (MapLibre adds it; src/offline/AndroidManifest.xml removes it otherwise).
  Every request goes through the map gateway, which refuses all of them
  while the map's toggle is off. Every requested permission must be on the
  allowlist in app/build.gradle.kts.
  Backups and device-to-device transfers carry nothing (allowBackup for
  Android 11 and below, dataExtractionRules for 12 and up).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MapLibre asks for this to check Wi-Fi; the app tells it it is
         online instead (app.terpoir.map.OnlineMap). -->
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        tools:node="remove" />

    <!-- Normal (install-time) permission for the system BiometricPrompt,
         which also covers the device-credential fallback. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- In-app camera for label, receipt and code scans (asked on first
         use). Photos stay in memory; nothing is written to the gallery. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Voice notes with the on-device speech recognizer (asked on first
         use). Terpoir never receives or keeps the audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Spot locations and "Show me", only while the app is open and only
         when the user asks: approximate by default, precise on request. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- "Notify me" (off by default): geofences need location "all the
         time", and the alert needs permission to notify (Android 13+).
         Asked only after the user turns it on. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the app see whether the system speech recognizer exists
         (package visibility); it never binds to any other recognizer. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".TerpoirApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Terpoir">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick capture (opt-in Privacy Center toggles): both ship
             disabled and are enabled only while their toggle is on. They
             show "New note" and nothing from the journal. -->
        <service
            android:name=".capture.NewNoteTileService"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_add"
            android:label="@string/capture_new_note"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".capture.NewNoteWidget"
            android:enabled="false"
            android:exported="true"
            android:label="@string/capture_new_note">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_new_note_info" />
        </receiver>

        <!-- Geofence events for "Notify me", from this app's own pending
             intents only. -->
        <receiver
            android:name=".alerts.GeofenceReceiver"
            android:exported="false" />

        <!-- The follow-up check-in alarm, from this app's own pending
             intent only. -->
        <receiver
            android:name=".alerts.CheckInReceiver"
            android:exported="false" />

        <!-- Serves a share card to the app the user picked, from memory;
             nothing is written to storage. Not exported: the share sheet
             grants a read permission for the one URI. -->
        <provider
            android:name=".share.ShareProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
