<!--
  The window behind the Compose UI, shown at launch before the first frame:
  Terroir's surface color, so there is no flash of a different color.
  Night variant in values-night.
-->
<resources>
    <style name="Theme.Terpoir" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/terroir_surface</item>
        <item name="android:colorBackground">@color/terroir_surface</item>
    </style>

    <color name="terroir_surface">#F3EFE7</color>
</resources>
