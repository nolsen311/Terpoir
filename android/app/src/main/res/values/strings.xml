    <string name="screen_protection">Screen protection</string>
    <string name="screen_protection_does">Blocks screenshots, screen recording and casting of Terpoir, and hides it in your recent apps. Screen readers and other accessibility tools keep working.</string>
    <string name="screen_protection_leaves">When off, screenshots and recordings of Terpoir are saved to your photo gallery, and from there to any cloud backup it syncs with.</string>
    <string name="screen_protection_who">When off, anyone you cast or share your screen with sees your journal, and so does any app allowed to capture your screen.</string>
    <string name="coa_links">Open lab-results links</string>
    <string name="coa_links_does">Lets you open the lab-results (COA) link from a label\'s QR code in your browser. Scanned links are saved with the product either way.</string>
    <string name="coa_links_leaves">When on, opening a link sends a request to the lab\'s or brand\'s website.</string>
    <string name="coa_links_who">That website and its host learn your IP address, when you looked, and which batch you bought, since the link usually names it. Your network provider can see which site you visited.</string>
    <string name="coa_links_undo">Turn it off here. Pages you already opened stay in your browser\'s history until you clear it.</string>
    <string name="voice_first">New notes start with voice</string>
    <string name="voice_first_does">The new-note button starts listening right away, using your phone\'s on-device speech recognition. Turn off to start with the keyboard instead.</string>
    <string name="voice_first_leaves">Nothing. Your voice is turned into text on your phone, never sent to an online service, and the recording isn\'t kept. When off, notes are typed, and your keyboard app sees everything you type.</string>
    <string name="voice_first_who">People nearby can hear what you say. With typing, your keyboard app sees your words, and third-party keyboards may send them elsewhere.</string>
    <string name="voice_first_undo">Change it here at any time. You can always switch between voice and typing in the note itself.</string>
    <string name="screen_protection_undo">Turn it back on here. Screenshots already taken stay in your gallery until you delete them.</string>

    <!-- Onboarding -->
    <string name="age_title">Before we roll</string>
    <string name="age_question">Are you of legal age to use cannabis where you live?</string>
    <string name="age_yes">Yes, I am</string>
    <string name="age_no">No</string>
    <string name="age_signal_disclosure">Google Play may tell Terpoir an age range for your account. Terpoir only checks it on this phone, to keep out under-18s, and never stores or sends it.</string>
    <string name="age_adults_only">Terpoir is for adults</string>
    <string name="age_adults_only_body">Come back when you\'re of legal age where you live.</string>
    <string name="recovery_title">Your recovery key</string>
    <string name="recovery_explainer">This key is the only way back into your journal if you lose or reset this phone. There\'s no reset link and no backdoor, and nobody, not even us, can recover your journal without it.</string>
    <string name="recovery_paper">Write it down and keep the paper somewhere safe, or keep it in a password manager. Not next to wherever you sync your journal: a key kept with the data it locks is no protection.</string>
    <string name="recovery_copy">Copy for a password manager</string>
    <string name="recovery_copy_disclosure">Your password manager, and its sync, become part of what protects your journal. Terpoir clears the clipboard after a minute.</string>
    <string name="recovery_never_ask">We will never ask for your recovery key.</string>
    <string name="recovery_saved">I\'ve saved it</string>
    <string name="recovery_skip">Skip for now</string>
    <string name="recovery_skip_title">Skip saving your key?</string>
    <string name="recovery_skip_body">Without your recovery key, losing, resetting or replacing this phone means losing your journal for good. This key won\'t be shown again.</string>
    <string name="recovery_skip_confirm">Skip, I accept data loss</string>
    <string name="recovery_skip_back">Go back</string>
    <string name="confirm_title">Check your copy</string>
    <string name="confirm_explainer">Type your recovery key from your saved copy. Capitals and dashes don\'t matter.</string>
    <string name="confirm_label">Recovery key</string>
    <string name="confirm_check">Check</string>
    <string name="confirm_show_again">Show my key again</string>
    <string name="confirm_matches">That\'s the one.</string>
