    <string name="confirm_invalid_character">There\'s a character that never appears in a recovery key.</string>
    <string name="confirm_typo">That doesn\'t match. Check your copy for a typo.</string>
    <string name="confirm_wrong_key">That\'s a recovery key, but not this journal\'s.</string>
